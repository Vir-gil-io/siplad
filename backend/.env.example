# ---------------------------------------------------------------------------
# SIPLAD — Variables de entorno del backend
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------------------

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Base de datos ---------------------------------------------------------
# Local con Docker Compose:
DATABASE_URL="postgresql://siplad:siplad@localhost:5432/siplad?schema=public"

# --- Seguridad -------------------------------------------------------------
# Genera un secreto largo y aleatorio. Ejemplo para obtener uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-este-valor-por-uno-aleatorio-de-al-menos-48-bytes"
JWT_EXPIRACION="8h"

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGENES="http://localhost:5173,http://localhost:4173"

# --- Integracion 1: Google OAuth2 ------------------------------------------
# Consola de Google Cloud -> APIs y servicios -> Credenciales ->
# Crear credenciales -> ID de cliente de OAuth -> Aplicacion web.
# URI de redireccionamiento autorizado: el valor de GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# A donde se envia al usuario despues de un inicio de sesion federado exitoso.
FRONTEND_URL="http://localhost:5173"

# --- Integracion 2: Cloudinary (almacenamiento de constancias) -------------
# Panel de Cloudinary -> Dashboard. Si se deja vacio, el sistema guarda
# los archivos en disco local y la aplicacion sigue funcionando.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Integracion 3: Nager.Date (dias festivos oficiales) -------------------
# Servicio publico sin clave de acceso.
NAGER_DATE_URL="https://date.nager.at/api/v3"
NAGER_DATE_PAIS="MX"
