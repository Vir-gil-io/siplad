flowchart LR

  subgraph L0["1 · Cliente"]
    direction TB
    NAV["Navegador<br/><i>docente · coordinación</i>"]
  end

  subgraph L1["2 · Punto de entrada"]
    direction TB
    BAL["Nginx balanceador<br/><i>round-robin</i>"]
    WEB["React 19 + Vite<br/>Tailwind · React Router<br/><i>estáticos en Nginx</i>"]
  end

  subgraph L2["3 · Réplicas de la API"]
    direction TB
    API1["Instancia 1<br/><i>NestJS</i>"]
    API2["Instancia 2<br/><i>NestJS</i>"]
  end

  subgraph L3["4 · Cadena transversal"]
    direction TB
    GJWT["JwtAuthGuard<br/><i>identidad</i>"]
    GROL["RolesGuard<br/><i>rol</i>"]
    VAL["ValidationPipe<br/><i>lista blanca de DTO</i>"]
    FIL["Filtro de excepciones<br/><i>errores sin fugas</i>"]
  end

  subgraph L4["5 · Controladores"]
    direction TB
    C1["/auth"]
    C2["/planeaciones"]
    C3["/avances"]
    C4["/evidencias"]
    C5["/reportes"]
  end

  subgraph L5["6 · Lógica de negocio"]
    direction TB
    S1["AuthService<br/><i>JWT · OAuth2</i>"]
    S2["PlaneacionesService<br/><i>unicidad · estados</i>"]
    S3["AvancesService<br/><i>clasifica · valida tramo</i>"]
    S4["EvidenciasService<br/><i>horas · validación</i>"]
    S5["ReportesService<br/><i>indicadores</i>"]
  end

  subgraph L6["7 · Integración"]
    direction TB
    I1["CloudinaryService<br/><i>Adapter</i>"]
    I2["FestivosService<br/><i>Adapter · caché</i>"]
    I3["ExportacionService<br/><i>PDF · Excel</i>"]
  end

  subgraph L7["8 · Datos"]
    direction TB
    REPO["Repositorios<br/><i>Prisma ORM</i>"]
    DB[("PostgreSQL<br/><i>parametrizado</i>")]
  end

  subgraph L8["9 · Servicios externos"]
    direction TB
    E1["Google OAuth2"]
    E2["Cloudinary"]
    E3["Nager.Date"]
  end

  NAV ==>|HTTPS| BAL
  BAL ==>|"/"| WEB
  BAL ==>|"/api · por turnos"| API1
  BAL ==>|"/api · por turnos"| API2

  API1 --> GJWT
  API2 --> GJWT
  GJWT --> GROL
  GROL --> VAL
  VAL --> L4
  FIL -. "normaliza toda excepción" .-> VAL

  C1 --> S1
  C2 --> S2
  C3 --> S3
  C4 --> S4
  C5 --> S5

  S2 --> I1
  S4 --> I1
  S3 --> I2
  S5 --> I2
  S5 --> I3

  L5 ==> REPO
  REPO ==> DB

  S1 ==> E1
  I1 ==> E2
  I2 ==> E3

  classDef externo fill:#ede7f6,stroke:#5a3c8f,color:#3f2a63;
  classDef almacen fill:#e4ebf5,stroke:#4a4f6b,color:#23263b;
  classDef guardia fill:#fdeeea,stroke:#ae3f2c,color:#8c3222;
  classDef replica fill:#f3eefb,stroke:#5a3c8f,color:#3f2a63;
