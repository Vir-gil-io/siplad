# ---------------------------------------------------------------------------
# SIPLAD — Variables de la orquestacion
#
# Copia este archivo como infra/.env y completa los valores.
# El archivo .env de infra NO se versiona.
#
#   Copy-Item infra\.env.example infra\.env
# ---------------------------------------------------------------------------

# --- Obligatoria ------------------------------------------------------------
# Sin esto, 'docker compose up' se detiene con un mensaje explicito.
# Genera el valor con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Opcionales con valor por omision --------------------------------------
JWT_EXPIRACION=8h

# El balanceador publica en el 8080. Si cambias el puerto en compose.yaml,
# ajusta tambien estas dos.
CORS_ORIGENES=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- Integracion 1: Google OAuth2 ------------------------------------------
# Recuerda agregar esta URI de retorno en la consola de Google Cloud, ademas
# de la de desarrollo:
#   http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# --- Integracion 2: Cloudinary ---------------------------------------------
# Si se deja vacio, las constancias y las planeaciones adjuntas se guardan en
# el disco del contenedor. Dentro de Docker ese disco es efimero: se pierde al
# recrear el contenedor.
#
# Para que los PDF se puedan abrir desde la direccion que devuelve Cloudinary
# hay que habilitar una sola vez, en la consola de Cloudinary:
#   Settings -> Security -> PDF and ZIP files delivery -> Allow delivery
# Sin eso, la entrega responde 401 "deny or ACL failure".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Integracion 3: Nager.Date ---------------------------------------------
NAGER_DATE_URL=https://date.nager.at/api/v3
NAGER_DATE_PAIS=MX
